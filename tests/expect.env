# What core A's given barrier and alternative are supposed to do.
# Read by tests/run_tests.sh, which is identical in all four cores.

VARIATION=A

# The alternative your BRIEF names, and whether it is supposed to work.
ALT_LABEL="the counter reset before the broadcast, and nothing else changed"
ALT_CORRECT=no

# The one claim about this core that a script checks. Lab 1 called this field
# SPEED_CHECK; in Lab 2 not every core's claim is about speed.
#   fixed_faster_than_given | fixed_faster_than_alt
#   fixed_cheaper_than_given | fixed_cheaper_than_alt      (CPU time, not wall)
#   given_correct_at_one_wrong_at_four
#   given_correct_at_two_deadlocks_at_four
#   none
#
# Core A's given barrier is FASTER than any correct one -- after the first
# round it does no synchronising at all -- so there is no timing claim to make
# here. The claim that matters is the shape of the failure: right at one
# thread, wrong at four, and it never stops. That is also the control
# experiment the brief asks for, and it is the same on every machine.
CORE_CHECK=given_correct_at_one_wrong_at_four
